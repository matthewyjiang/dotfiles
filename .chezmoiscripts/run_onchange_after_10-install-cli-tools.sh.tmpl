{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/bin/sh
set -eu

# Generated by chezmoi from .chezmoiscripts/run_onchange_after_10-install-cli-tools.sh.tmpl.
# Installs the dev tools declared in ~/.config/mise/conf.d/dotfiles.toml with
# mise, bootstrapping mise into ~/.local/bin first if it is missing. chezmoi
# re-runs this whenever that file changes (or after a failed run):
# dotfiles.toml sha256: {{ include "dot_config/mise/conf.d/dotfiles.toml" | sha256sum }}

log() { printf '%s\n' "chezmoi mise: $*"; }

mise_bin="$(command -v mise 2>/dev/null || printf '%s' "$HOME/.local/bin/mise")"
if [ ! -x "$mise_bin" ]; then
  log "installing mise to $mise_bin"
  curl -fsSL https://mise.run | MISE_INSTALL_PATH="$mise_bin" sh
fi

# Run from $HOME so only global config (config.toml + conf.d/*) is in scope.
cd "$HOME"
log "installing tools from global mise config"
"$mise_bin" install
{{- end -}}
